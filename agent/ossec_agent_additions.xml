<!-- BEGIN SIEMSOAR (appended by agent/install_wazuh_agent.sh on every lab host) -->
<ossec_config>
  <!-- File integrity monitoring (real-time). Watch the DIRECTORIES and restrict to the files: useradd, usermod, chpasswd
       and visudo write a new file and rename it over the old one, so a real-time watch on the file itself only sees
       the first change (measured on the lab and reproduced on wazuh-manager 4.14.8: 1 alert for 3 changes). -->
  <syscheck>
    <directories realtime="yes" check_all="yes" report_changes="yes">/srv/lab</directories>
    <!-- who-data (auditd) on the account files and the persistence locations: the alert also names the process that
         wrote the file (syscheck.audit.process.name), so a package manager's write can be told from an attacker's.
         Measured need: rules 100140/100142 fired on apt installing a cron job and on an administrator's profile.d file
         (lab 2026-10-20). https://documentation.wazuh.com/current/user-manual/capabilities/file-integrity/advanced-settings.html -->
    <directories whodata="yes" check_all="yes" recursion_level="0" restrict="^/etc/passwd$|^/etc/shadow$|^/etc/sudoers$|^/etc/profile$|^/etc/bash.bashrc$|^/etc/crontab$">/etc</directories>
    <directories realtime="yes" check_all="yes" recursion_level="0" restrict="^/etc/ssh/sshd_config$">/etc/ssh</directories>
    <!-- persistence through SSH keys (rule 100104): root and the Ubuntu AMI default user -->
    <directories realtime="yes" check_all="yes" recursion_level="0" restrict="/authorized_keys$">/root/.ssh,/home/ubuntu/.ssh</directories>
    <!-- persistence locations (T1053.003 cron, T1543.002 systemd, T1546.004 shell configuration) -->
    <directories whodata="yes" check_all="yes" recursion_level="0">/etc/cron.d,/var/spool/cron/crontabs,/etc/systemd/system,/etc/profile.d</directories>
    <directories whodata="yes" check_all="yes" recursion_level="0" restrict="^/root/.bashrc$|^/root/.profile$|^/root/.bash_profile$|^/root/.bash_logout$">/root</directories>
    <frequency>3600</frequency>
  </syscheck>

  <!-- Linux audit log (auditd, rules in agent/siemsoar.rules): log format documented by Wazuh
       https://documentation.wazuh.com/current/user-manual/capabilities/system-calls-monitoring/audit-configuration.html -->
  <localfile>
    <log_format>audit</log_format>
    <location>/var/log/audit/audit.log</location>
  </localfile>

  <!-- Not repeated here on purpose: the stock Linux agent already reads /var/log/auth.log and /var/log/syslog
       (etc/templates/config/generic/localfile-logs/syslog-logs.template in Wazuh 4.14). A second <localfile> for the
       same file would ingest every sshd/useradd line twice and distort frequency rules such as 5712/5763. -->
</ossec_config>
<!-- END SIEMSOAR -->
