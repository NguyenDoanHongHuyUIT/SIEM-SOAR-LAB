+
+def test_dry_run_never_reaches_a_mutating_sdk_call():
+    stop_gate, key_gate = STATES["ShouldStopInstance"], STATES["ShouldDisableKey"]
+    assert {"Variable": "$.config.dry_run", "BooleanEquals": False} in stop_gate["Choices"][0]["And"]
