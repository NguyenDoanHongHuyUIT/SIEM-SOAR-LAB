-               "techniques": s.get("techniques", []), "expect": s.get("expect", []),
+               "canary": bool(s.get("canary")), "techniques": s.get("techniques", []), "expect": s.get("expect", []),
                "started_at": started.strftime("%Y-%m-%dT%H:%M:%S.%fZ")[:-4] + "Z"}
