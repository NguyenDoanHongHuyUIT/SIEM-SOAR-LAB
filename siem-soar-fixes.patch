+def _split_args(raw: str) -> list[str]:
+    out, cur, depth, quote = [], [], 0, False
+    for ch in raw:
+        if ch == "'":
+            quote = not quote
+        if not quote and ch == "(":
+            depth += 1
+        if not quote and ch == ")":
+            depth -= 1
+        if ch == "," and depth == 0 and not quote:
+            out.append("".join(cur).strip())
+            cur = []
+        else:
+            cur.append(ch)
+    if "".join(cur).strip():
+        out.append("".join(cur).strip())
+    return out
+
