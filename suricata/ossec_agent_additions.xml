<!-- BEGIN SIEMSOAR (appended by bootstrap_sensor.sh) -->
<ossec_config>
  <!-- Suricata EVE JSON -> Wazuh (decoded by the built-in json/suricata decoders) -->
  <localfile>
    <log_format>json</log_format>
    <location>/var/log/suricata/eve.json</location>
  </localfile>

  <!-- File integrity monitoring (real-time). Watch the DIRECTORIES and restrict to the files: useradd, usermod, chpasswd
       and visudo write a new file and rename it over the old one, so a real-time watch on the file itself only sees
       the first change (measured on the lab and reproduced on wazuh-manager 4.14.8: 1 alert for 3 changes). -->
  <syscheck>
    <directories realtime="yes" check_all="yes" report_changes="yes">/srv/lab</directories>
    <directories realtime="yes" check_all="yes" recursion_level="0" restrict="^/etc/passwd$|^/etc/shadow$|^/etc/sudoers$">/etc</directories>
    <directories realtime="yes" check_all="yes" recursion_level="0" restrict="^/etc/ssh/sshd_config$">/etc/ssh</directories>
    <!-- persistence through SSH keys (rule 100104): root and the Ubuntu AMI default user -->
    <directories realtime="yes" check_all="yes" recursion_level="0" restrict="/authorized_keys$">/root/.ssh,/home/ubuntu/.ssh</directories>
    <frequency>3600</frequency>
  </syscheck>

  <!-- Not repeated here on purpose: the stock Linux agent already reads /var/log/auth.log and /var/log/syslog
       (etc/templates/config/generic/localfile-logs/syslog-logs.template in Wazuh 4.14). A second <localfile> for the
       same file would ingest every sshd/useradd line twice and distort frequency rules such as 5712/5763. -->
</ossec_config>
<!-- END SIEMSOAR -->
