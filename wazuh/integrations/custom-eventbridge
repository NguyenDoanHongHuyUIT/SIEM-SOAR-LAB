#!/bin/sh
# Wazuh integratord entry point. Uses the system python3 (python3-boto3) instead of Wazuh's embedded
# interpreter, which ships without boto3. Credentials come from the instance profile (IMDSv2).
DIR_NAME="$(cd "$(dirname "$0")" && pwd -P)"
SCRIPT_NAME="$(basename "$0")"
exec /usr/bin/python3 "${DIR_NAME}/${SCRIPT_NAME}.py" "$@"
