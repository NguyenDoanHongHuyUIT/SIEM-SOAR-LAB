<!-- BEGIN SIEMSOAR (appended by bootstrap_manager.sh; Wazuh merges multiple <ossec_config> blocks) -->
<ossec_config>
  <!-- Only alerts of rules in state "active" or "enforce" leave the SIEM; shadow rules stay in Wazuh only. -->
  <integration>
    <name>custom-eventbridge</name>
    <hook_url>eventbridge://default?region=__REGION__</hook_url>
    <group>siemsoar_active,siemsoar_enforce</group>
    <alert_format>json</alert_format>
  </integration>

  <!-- CloudTrail archive: lets the on-demand plane catch up on API activity after it was switched off. -->
  <wodle name="aws-s3">
    <disabled>no</disabled>
    <interval>10m</interval>
    <run_on_start>yes</run_on_start>
    <skip_on_error>yes</skip_on_error>
    <bucket type="cloudtrail">
      <name>__CLOUDTRAIL_BUCKET__</name>
    </bucket>
  </wodle>
</ossec_config>
<!-- END SIEMSOAR -->
