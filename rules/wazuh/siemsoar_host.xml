<!--
  SIEMSOAR detection-as-code: host rules (ids 100100-100199).

  Design rule: do not re-implement detections Wazuh already ships. A SIEMSOAR rule is either
    * a policy rule on top of an official rule, i.e. <if_sid> of an official rule (5902, 5712, 5763, 550 ...): the
      official decoder, regex and frequency/timeframe logic stay authoritative and this rule only decides that the
      alert is worth a case (level, MITRE, lifecycle state, response). `tools.rulesctl lint` checks that every parent
      exists in the pinned official ruleset (rules/reference/wazuh-<version>.json), or
    * a lab-specific rule for something no official rule can know (the canary directory).

  Authoring rules:
    * every <rule id> needs rules/metadata/wazuh-<id>.yml (state, MITRE, expected FP, positive/negative tests)
    * do NOT add <group> siemsoar_<state> / resp_<x> tags here: `tools/rulesctl.py build` injects them from
      the metadata, which is how shadow/active/enforce/deprecated is controlled from Git.
    * MITRE ids must exist and not be revoked in the pinned ATT&CK snapshot (lint).
-->
<group name="siemsoar,syscheck,">
  <!-- Official 550 ("Integrity checksum changed", level 7) fires for every monitored file. These rules raise the few
       files whose change means account/privilege tampering. Monitored paths: suricata/ossec_agent_additions.xml. -->
  <rule id="100100" level="12">
    <if_sid>550</if_sid>
    <field name="file">^/etc/passwd$</field>
    <description>SIEMSOAR: /etc/passwd was modified</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <rule id="100102" level="10">
    <if_sid>550</if_sid>
    <field name="file">^/etc/shadow$</field>
    <description>SIEMSOAR: /etc/shadow was modified</description>
    <mitre>
      <id>T1078.003</id>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <rule id="100103" level="10">
    <if_sid>550</if_sid>
    <field name="file">^/etc/sudoers$</field>
    <description>SIEMSOAR: /etc/sudoers was modified</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <rule id="100104" level="10">
    <if_sid>550,554</if_sid>
    <field name="file">/.ssh/authorized_keys$</field>
    <description>SIEMSOAR: SSH authorized_keys created or modified</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
  </rule>

  <!-- Lab-specific: a deception (canary) directory no official rule knows about. -->
  <rule id="100101" level="7">
    <if_sid>550,554</if_sid>
    <field name="file">^/srv/lab/</field>
    <description>SIEMSOAR: file changed in the lab canary directory</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>
</group>

<group name="siemsoar,adduser,">
  <!-- Official 5902 matches syslog "new user" / "new account added" (useradd, adduser). -->
  <rule id="100110" level="10">
    <if_sid>5902</if_sid>
    <description>SIEMSOAR: new local user account created</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>
  <!-- Exception: an account whose shell refuses logins (nologin(8), false(1)) is not an interactive foothold; package
       scripts and adduser for system accounts create them. It is still alerted, at a low level. A later switch to a
       login shell is reported by the official rule 5904 (usermod, T1098). Measured on the lab (2026-10-19): every
       Atomic T1136.001 account had /bin/bash, the benign service account /usr/sbin/nologin. -->
  <rule id="100112" level="3">
    <if_sid>100110</if_sid>
    <match>shell=/usr/sbin/nologin|shell=/sbin/nologin|shell=/bin/false|shell=/usr/bin/false</match>
    <description>SIEMSOAR: new service account without a login shell</description>
  </rule>
</group>

<group name="siemsoar,authentication_failures,sshd,">
  <!-- Official brute-force detections (8 events in 120 s from one source, ignore=60 s):
         5763 = failed password for an existing user (built on 5760)
         5712 = attempts with a non-existent user (built on 5710)
       These wrap them instead of duplicating the counting logic with our own numbers. -->
  <rule id="100120" level="10">
    <if_sid>5763</if_sid>
    <description>SIEMSOAR: SSH brute force against an existing account</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100121" level="10">
    <if_sid>5712</if_sid>
    <description>SIEMSOAR: SSH brute force with non-existent accounts</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>
