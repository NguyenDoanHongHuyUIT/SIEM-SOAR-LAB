# SIEMSOAR detection-as-code: network rules (sids 9000001-9000099). Metadata: rules/metadata/suricata-<sid>.yml
# `tools/rulesctl.py build` generates the matching Wazuh rule (id 110000 + sid - 9000000) that carries the
# lifecycle state, so Suricata always alerts and Wazuh decides whether an alert may become a case.
alert http any any -> any any (msg:"SIEMSOAR-LAB path traversal"; flow:established,to_server; http.uri; content:"../../"; classtype:web-application-attack; sid:9000001; rev:1;)
alert http any any -> any any (msg:"SIEMSOAR-LAB sqlmap user agent"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000002; rev:1;)
alert dns any any -> any any (msg:"SIEMSOAR-LAB suspicious DNS lookup of lab C2 domain"; dns.query; content:".lab-c2.test"; nocase; classtype:trojan-activity; sid:9000003; rev:1;)
