{
  "Comment": "SIEM/SOAR case workflow: enrich -> approve -> contain -> verify -> restore (generated by tools/gen_asl.py)",
  "StartAt": "Enrich",
  "TimeoutSeconds": 1209600,
  "States": {
    "Enrich": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_enrich}",
        "Payload": {
          "op": "enrich",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.enrich",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "NotifyApproval"
    },
    "NotifyApproval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${fn_notify}",
        "Payload": {
          "op": "request",
          "gate": "approval",
          "state.$": "$",
          "task_token.$": "$$.Task.Token"
        }
      },
      "TimeoutSecondsPath": "$.config.approval_timeout",
      "ResultPath": "$.approval",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "MarkExpired"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "ApprovalChoice"
    },
    "ApprovalChoice": {
      "Type": "Choice",
      "Default": "FailSafe",
      "Choices": [
        {
          "Variable": "$.approval.decision",
          "StringEquals": "approve",
          "Next": "Preflight"
        },
        {
          "Variable": "$.approval.decision",
          "StringEquals": "acknowledge",
          "Next": "MarkAcknowledged"
        },
        {
          "Variable": "$.approval.decision",
          "StringEquals": "dismiss",
          "Next": "RecordFeedbackDismiss"
        }
      ]
    },
    "MarkAcknowledged": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_case_ops}",
        "Payload": {
          "op": "acknowledged",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.ack",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "DoneAcknowledged"
    },
    "DoneAcknowledged": {
      "Type": "Succeed"
    },
    "RecordFeedbackDismiss": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_case_ops}",
        "Payload": {
          "op": "feedback",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.feedback",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "DoneDismissed"
    },
    "DoneDismissed": {
      "Type": "Succeed"
    },
    "MarkExpired": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_case_ops}",
        "Payload": {
          "op": "expire",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.expire",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "NotifyExpired"
    },
    "NotifyExpired": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_notify}",
        "Payload": {
          "op": "info",
          "state.$": "$",
          "kind": "expired"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.notify_expired",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notify_error",
          "Next": "DoneExpired"
        }
      ],
      "Next": "DoneExpired"
    },
    "DoneExpired": {
      "Type": "Succeed"
    },
    "Preflight": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_preflight}",
        "Payload": {
          "op": "preflight",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.preflight",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "SaveState"
    },
    "SaveState": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_save_state}",
        "Payload": {
          "op": "save_state",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.save_state",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "PlanChoice"
    },
    "PlanChoice": {
      "Type": "Choice",
      "Default": "FailSafe",
      "Choices": [
        {
          "Variable": "$.steps.enrich.out.plan_type",
          "StringEquals": "ec2_isolate",
          "Next": "SnapshotEvidence"
        },
        {
          "Variable": "$.steps.enrich.out.plan_type",
          "StringEquals": "iam_key_disable",
          "Next": "DisableKey"
        }
      ]
    },
    "SnapshotEvidence": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_contain}",
        "Payload": {
          "op": "snapshot",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.snapshot",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "IsolateNetwork"
    },
    "IsolateNetwork": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_contain}",
        "Payload": {
          "op": "isolate_network",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.isolate",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "RevokeSessions"
    },
    "RevokeSessions": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_contain}",
        "Payload": {
          "op": "revoke_sessions",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.revoke",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "StopInstance"
    },
    "StopInstance": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_contain}",
        "Payload": {
          "op": "stop_instance",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.stop",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "VerifyContainment"
    },
    "DisableKey": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_contain}",
        "Payload": {
          "op": "disable_key",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.disable_key",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "RevokeUserSessions"
    },
    "RevokeUserSessions": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_contain}",
        "Payload": {
          "op": "revoke_user_sessions",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.revoke",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "VerifyContainment"
    },
    "VerifyContainment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_contain}",
        "Payload": {
          "op": "verify",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.verify",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "NotifyIsolated"
    },
    "NotifyIsolated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_notify}",
        "Payload": {
          "op": "info",
          "state.$": "$",
          "kind": "isolated"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.notify_isolated",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notify_error",
          "Next": "WaitRestoreDecision"
        }
      ],
      "Next": "WaitRestoreDecision"
    },
    "WaitRestoreDecision": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${fn_notify}",
        "Payload": {
          "op": "request",
          "gate": "restore",
          "state.$": "$",
          "task_token.$": "$$.Task.Token"
        }
      },
      "TimeoutSecondsPath": "$.config.restore_timeout",
      "ResultPath": "$.restore_decision",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "ValidateRestore"
    },
    "ValidateRestore": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_restore}",
        "Payload": {
          "op": "validate",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.validate_restore",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "RestoreAllowed"
    },
    "RestoreAllowed": {
      "Type": "Choice",
      "Default": "NotifyBlocked",
      "Choices": [
        {
          "Variable": "$.steps.validate_restore.out.ok",
          "BooleanEquals": true,
          "Next": "ExecuteRestore"
        }
      ]
    },
    "NotifyBlocked": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_notify}",
        "Payload": {
          "op": "info",
          "state.$": "$",
          "kind": "blocked"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.notify_blocked",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notify_error",
          "Next": "BlockedTerminal"
        }
      ],
      "Next": "BlockedTerminal"
    },
    "BlockedTerminal": {
      "Type": "Choice",
      "Default": "WaitRestoreDecision",
      "Choices": [
        {
          "Variable": "$.steps.validate_restore.out.terminal",
          "BooleanEquals": true,
          "Next": "SetBlockedError"
        }
      ]
    },
    "SetBlockedError": {
      "Type": "Pass",
      "ResultPath": "$.error",
      "Next": "FailSafe",
      "Result": {
        "Error": "RestoreBlocked",
        "Cause": "restore validation failed after the maximum number of attempts"
      }
    },
    "ExecuteRestore": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_restore}",
        "Payload": {
          "op": "execute",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.execute_restore",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "VerifyRestore"
    },
    "VerifyRestore": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_restore}",
        "Payload": {
          "op": "verify",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.verify_restore",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "WasFalsePositive"
    },
    "WasFalsePositive": {
      "Type": "Choice",
      "Default": "NotifyRestored",
      "Choices": [
        {
          "Variable": "$.restore_decision.decision",
          "StringEquals": "restore_fp",
          "Next": "RecordFeedbackFP"
        }
      ]
    },
    "RecordFeedbackFP": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_case_ops}",
        "Payload": {
          "op": "feedback",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.feedback",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailSafe"
        }
      ],
      "Next": "NotifyRestored"
    },
    "NotifyRestored": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_notify}",
        "Payload": {
          "op": "info",
          "state.$": "$",
          "kind": "restored"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.notify_restored",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notify_error",
          "Next": "DoneRestored"
        }
      ],
      "Next": "DoneRestored"
    },
    "DoneRestored": {
      "Type": "Succeed"
    },
    "FailSafe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${fn_case_ops}",
        "Payload": {
          "op": "fail_safe",
          "state.$": "$"
        }
      },
      "ResultSelector": {
        "out.$": "$.Payload"
      },
      "ResultPath": "$.steps.fail_safe",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.fail_safe_error",
          "Next": "CaseFailed"
        }
      ],
      "Next": "CaseFailed"
    },
    "CaseFailed": {
      "Type": "Fail",
      "Error": "CaseFailedSafe",
      "Cause": "Workflow failed; the last safe state was kept and operators were alerted"
    }
  }
}
