#!/bin/bash
# Generated by Terraform. Heavy lifting lives in wazuh/ + suricata/ + scripts/ (synced from S3).
set -euo pipefail
exec > >(tee -a /var/log/siemsoar-userdata.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y awscli curl jq python3-boto3 unzip
mkdir -p /opt/siemsoar
cat > /opt/siemsoar/env <<'ENVEOF'
REGION=${region}
PREFIX=${prefix}
BOOT_BUCKET=${boot_bucket}
WAZUH_VERSION=${wazuh_version}
MANAGER_IP=${manager_ip}
CLOUDTRAIL_BUCKET=${cloudtrail_bkt}
ENVEOF
aws s3 sync "s3://${boot_bucket}/bootstrap/" /opt/siemsoar/bootstrap/ --region "${region}"
chmod -R 750 /opt/siemsoar/bootstrap
bash /opt/siemsoar/bootstrap/${role == "manager" ? "wazuh/bootstrap_manager.sh" : "suricata/bootstrap_sensor.sh"}
